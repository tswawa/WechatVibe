{
  "appId": "com.local.wechatvibe.real-client",
  "productName": "WechatVibe",
  "directories": {
    "output": "__CLEAN_BUILD_OUTPUT__"
  },
  "electronDist": "__ELECTRON_DIST__",
  "extraMetadata": {
    "name": "wechatvibe",
    "author": "tswawa",
    "description": "WechatVibe local chat analysis and portraits",
    "main": "scripts/desktop-main.cjs"
  },
  "files": [
    "scripts/desktop-main.cjs",
    "scripts/real-client-shell.cjs",
    "scripts/real-client-preload.cjs",
    "scripts/real-client-recovery.cjs",
    "scripts/real-client-update.cjs",
    "scripts/real-client-update-controller.cjs",
    "scripts/real-client-update-helper.cjs",
    "scripts/update-signing.pub",
    "package.json",
    "!node_modules/**"
  ],
  "extraResources": [
    {
      "from": "__CLEAN_STAGE_CLIENT__",
      "to": "client",
      "filter": ["**/*", "!node_modules/**"]
    },
    {
      "from": "__CLEAN_STAGE_NODE_MODULES__",
      "to": "client/node_modules",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": ["dir"],
    "icon": "chatui/assets/wechatvibe-icon.ico",
    "executableName": "WechatVibe"
  }
}
